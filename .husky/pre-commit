#!/usr/bin/env sh

if [ ! -f "vendor/bin/phpcs" ] || [ ! -f "vendor/bin/phpstan" ]; then
  echo "❌ Composer dependencies not found. Please run 'composer install'."
  exit 1
fi

echo "🔍 [1/3] Running PHPCS..."
vendor/bin/phpcs || exit 1

echo "🔍 [2/3] Running PHPStan..."
vendor/bin/phpstan analyse --memory-limit=4G || exit 1

echo "🧪 [3/3] Running PHPUnit..."
vendor/bin/phpunit || exit 1

echo "✅ All pre-commit checks passed!"
